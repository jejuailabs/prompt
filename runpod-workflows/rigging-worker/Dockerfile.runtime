FROM ghcr.io/jejuailabs/playlab-skintokens@sha256:664ba37b000bc1c0fbff5d04e6f7d44616b4f1f2db6e01a6fa44d5ed778bfdef
COPY runpod-workflows/rigging-worker/patch_skintokens.py /opt/worker/patch_skintokens.py
RUN python /opt/worker/patch_skintokens.py
RUN apt-get update && apt-get install -y --no-install-recommends libsm6 libice6 libxext6 libxfixes3 libxxf86vm1 libegl1 libx11-6 libxrandr2 libxcursor1 libxinerama1 && rm -rf /var/lib/apt/lists/*
# Fail CI on missing shared libraries, before paying for a GPU job.
RUN python -c "import bpy; bpy.ops.wm.read_factory_settings(use_empty=True); print('Blender runtime verified:', bpy.app.version_string)"
COPY runpod-workflows/character-worker/process.py runpod-workflows/character-worker/policy.py /opt/character/
COPY runpod-workflows/rigging-worker/handler.py runpod-workflows/rigging-worker/retarget.py runpod-workflows/rigging-worker/skin_repair.py /opt/worker/
# Do not let the base image's older preparation script silently shadow a new
# worker build.  This catches a Docker context / ignore-rule regression in CI.
RUN python -m py_compile /opt/character/process.py /opt/character/policy.py
RUN PYTHONPATH=/opt/worker python -c "from skin_repair import repair_weights, inspect_deformation; from retarget import bake; print('Rigging modules verified')"
